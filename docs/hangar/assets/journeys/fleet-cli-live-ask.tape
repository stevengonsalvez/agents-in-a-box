# One continuous live proof. No seeded picker or fake provider.
Output "/tmp/fleet-cli-live-ask.gif"

Set Shell "bash"
Set FontSize 18
Set Width 1800
Set Height 1000
Set Padding 16

Type "cd /private/tmp/ainb-fleet-cli-ask.iyGIxJ && HANGAR_DAEMON_BIN=/tmp/ainb-fleet-cli-ask-target/debug/ainb-hangar-daemon scripts/record-live-fleet-cli-ask.sh"
Enter
Sleep 125s
