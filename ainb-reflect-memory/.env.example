# ainb-reflect-memory — environment template.
#
# Copy to `.env` (git-ignored) and fill from Bitwarden — NEVER commit real
# values. See docs/setup.md for the Bitwarden item/field names.
#
#   cp .env.example .env
#
# Placeholders only below. None of these are required to run the UNIT tests
# (`pytest -m "not integration"`); they are only needed to talk to a live
# database (migration, seed, integration tests).

# Postgres connection string for migrations / seed / integration tests.
# Supabase gives you this under Project Settings → Database → Connection string
# (use the pooler/session string for app traffic, the direct string for
# migrations). Format:
#   postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=

# Supabase project URL, e.g. https://YOUR-PROJECT-ref.supabase.co
SUPABASE_URL=

# Anon (public) key — ONLY if a direct browser/PostgREST client path is used.
# Safe to expose to clients; still gated by RLS.
SUPABASE_ANON_KEY=

# Service-role key — migrations / trusted server-side workers ONLY.
# !! Bypasses RLS. NEVER ship to browser/client code. NEVER commit. !!
SUPABASE_SERVICE_ROLE_KEY=

# Optional: a separate throwaway database URL for integration tests, so they
# never point at a real project. If set, tests prefer DATABASE_URL, then this.
REFLECT_TEST_DATABASE_URL=

# Shared nano-graphrag backend (reflect-kb LearningsGraphEngine). When BOTH are
# set, reflect's graph/vectors/community reports live in shared Postgres instead
# of per-machine local files. REFLECT_PG_DSN defaults to DATABASE_URL if unset.
REFLECT_PG_DSN=
REFLECT_WORKSPACE_ID=
